# Copy to .env and fill in. Never commit .env.
# Each feed in feeds.yaml points to one of these variables through `webhookEnv`.

# Discord webhook for the Nuxt blog channel
DISCORD_WEBHOOK_NUXT=https://discord.com/api/webhooks/<id>/<token>

# Discord webhook for the NestJS releases channel
DISCORD_WEBHOOK_NESTJS=https://discord.com/api/webhooks/<id>/<token>

# Polling schedule (cron syntax). Default: every hour, on the hour.
POLL_CRON=0 * * * *

# Optional: Uptime Kuma push monitor URL (type "Push"), called after each
# cycle with status=up, or status=down naming the failing feeds. Secret.
UPTIME_KUMA_PUSH_URL=

# Where the SQLite store lives (mounted as a Docker volume in production)
DATA_DIR=./data

# Path to the feeds file (default: feeds.yaml in the working directory)
FEEDS_FILE=feeds.yaml
