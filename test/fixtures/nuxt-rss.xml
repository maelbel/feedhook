        <item>
            <title><![CDATA[Nuxt Security Patch Releases]]></title>
            <link>https://nuxt.com/blog/v4-5-security</link>
            <guid isPermaLink="true">https://nuxt.com/blog/v4-5-security</guid>
            <pubDate>Mon, 27 Jul 2026 00:00:00 GMT</pubDate>
            <description><![CDATA[Nuxt 4.5.1 and 3.21.10 are out now, fixing several security issues, alongside a critical fix in @nuxt/devtools 3.3.1. We recommend upgrading as soon as possible.]]></description>
            <category>Release</category>
            <enclosure url="https://nuxt.com/assets/blog/v4.5.1.png" length="0" type="image/png"/>
        </item>
        <item>
